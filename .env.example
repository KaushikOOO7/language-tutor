# Copy to .env. Node 24 or newer is required. Secrets stay on the server.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/tutor.sqlite
# disabled | openai-compatible | anthropic
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
# For OpenAI-compatible providers, include /v1. Local providers may omit a key.
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=8000
# Choose the token parameter accepted by your compatible model API.
AI_TOKEN_PARAMETER=max_tokens
# Explicitly enable this only for a local provider that does not need authentication.
AI_ALLOW_KEYLESS=false
# disabled | openai-compatible | azure
# OpenAI-compatible transcription evaluates language from the transcript;
# Azure pronunciation assessment also measures pronunciation and fluency from audio.
SPEECH_PROVIDER=disabled
SPEECH_API_KEY=
SPEECH_BASE_URL=https://api.openai.com/v1
SPEECH_MODEL=whisper-1
AZURE_SPEECH_REGION=
# Enable only locales actually supported by your speech resource.
SPEECH_PRONUNCIATION_LOCALES=en-US,en-GB,es-ES,fr-FR,de-DE,it-IT,pt-BR,ja-JP,ko-KR,zh-CN,hi-IN
# llm | azure. LLM translation runs through the configured AI agent provider.
TRANSLATION_PROVIDER=llm
TRANSLATION_API_KEY=
TRANSLATION_REGION=
TRANSLATION_BASE_URL=https://api.cognitive.microsofttranslator.com
# disabled | azure-document-intelligence
OCR_PROVIDER=disabled
OCR_API_KEY=
# Your Azure Document Intelligence resource URL, without a trailing API path.
OCR_BASE_URL=
# Set true behind HTTPS in production. Set APP_ORIGIN to your public origin.
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
